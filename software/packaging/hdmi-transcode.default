# Extra arguments for hdmi-transcode at boot. Normally empty: the output mode, picture
# shape and test pattern are set from the web page (http://<box>/) and saved in
# /var/lib/hdmi-transcode/settings. Arguments here override those settings at every boot.
#   --mode WxH[@Hz]                              force an output mode
#   --aspect compress|letterbox|crop|native      force the picture shape
#   --port N                                     web page port (default 80)
HT_ARGS=""
