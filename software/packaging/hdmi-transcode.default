# Arguments for hdmi-transcode at boot. Until the config web page (R9) exists, change the
# output here and run `sudo systemctl restart hdmi-transcode`.
#   --mode WxH[@Hz]                              force an output mode (default: automatic)
#   --aspect compress|letterbox|crop|native      R3 aspect handling (default: compress)
HT_ARGS="--aspect compress"
