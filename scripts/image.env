# Pinned Radxa Zero 3 OS image for bring-up. Sourced by fetch-image.sh,
# prepare-firstboot.sh and flash-sd.sh; change the pins here and only here.
#
# rsdk-b1 (2025-07-15): Debian Bookworm, Radxa BSP kernel 6.1.84-10-rk2410-nocsf,
# aic8800 WiFi driver. The newest Radxa release (checked 2026-10-11). Replaces b6
# (2024-01, kernel 5.10), which hung ~10 s into boot on our 2026 V1.12 boards:
# Radxa changed the 3W's WiFi module after launch and pre-change images lack it.
# Only a KDE variant is published; the desktop is switched off after first boot.
IMAGE_REPO="radxa-build/radxa-zero3"
IMAGE_RELEASE="rsdk-b1"
IMAGE_ASSET="radxa-zero3_bookworm_kde_b1.output_512.img.xz"   # as published
IMAGE_NAME="radxa-zero3_bookworm_kde_b1"                      # local .img basename
# sha512 of the COMPRESSED asset, from the release's .sha512sum (verified 2026-10-11)
IMAGE_SHA512="6f9f67df6f997bef41aac2cc568ebb4b7820216be1256a49ce472cb877684c08ad793ff726da3155a02f0eab60b2b2c9318168b3cf8fab81849ae91e8724f10d"
IMAGE_DIR="${IMAGE_DIR:-$HOME/Downloads/radxa}"
